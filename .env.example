# =========
# Core API
# =========

# Required: Postgres connection URL for API, CLI, and Worker
DATABASE_URL=postgres://user:password@localhost:5432/routepilot?sslmode=disable

# Optional: HTTP server port (default: 8080)
HTTP_PORT=8080

# Optional: Feature flag cache settings
# Maximum number of cached flag rule sets (default: 1000)
CACHE_MAX_SIZE=1000
# Entry time-to-live (default: 30s). Examples: 10s, 1m, 5m
CACHE_TTL=30s
# How often to clean up expired cache entries (default: 5m)
CACHE_CLEANUP_INTERVAL=5m

# Optional but recommended: 32-byte key for API key secret decryption (AES-256-GCM)
# Must be exactly 32 characters/bytes. Example below is placeholder only.
API_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef


# =========
# Worker
# =========

# Kafka brokers list (comma-separated)
KAFKA_BROKERS=localhost:9092

# Kafka producer behavior
KAFKA_RETRY_MAX=3
KAFKA_RETRY_BACKOFF=100ms
KAFKA_FLUSH_TIMEOUT=10s

# Outbox worker settings
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=5s
OUTBOX_PROCESS_TIMEOUT=30s
OUTBOX_SHUTDOWN_TIMEOUT=30s

# Optional: DB pool tuning used by worker (not strictly required)
DATABASE_MAX_CONNECTIONS=10
DATABASE_MAX_IDLE_TIME=30m
DATABASE_MAX_LIFETIME=1h
DATABASE_CONNECT_TIMEOUT=10s


# =========
# CLI
# =========

# CLI uses DATABASE_URL when --database-url flag is not provided
# DATABASE_URL (defined above) is reused by the CLI

